# Environment variables for AI Eyes Web Client

# API base URL (legacy, still used by some components)
VITE_API_BASE=http://localhost:8000

# Backend URL for development proxy
# This configures where Vite dev server proxies API requests
# Default: http://127.0.0.1:8011
VITE_BACKEND_URL=http://127.0.0.1:8011

# For production builds, you can change this to your deployed backend:
# VITE_BACKEND_URL=https://your-backend-domain.com
# VITE_BACKEND_URL=http://192.168.1.100:8011  # For local network testing